---
const path = Astro.url.pathname;
const isHome = path === "/";
const isAbout = path === "/about" || path.startsWith("/about/");
---

<header class="site-header">
  <div class="container-wide">
    <div class="site-header-inner">
      <a class="brand" href="/" aria-label="Verso, página inicial">
        <span class="brand-name">Verso</span>
        <span class="brand-tagline">um diário</span>
      </a>

      <nav class="primary" aria-label="Principal">
        <a
          href="/"
          class:list={{ active: isHome }}
          aria-current={isHome ? "page" : undefined}>Início</a
        >
        <a
          href="/about"
          class:list={{ active: isAbout }}
          aria-current={isAbout ? "page" : undefined}>Sobre</a
        >
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    padding: 36px 0 0;
  }

  .site-header-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 28px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .brand,
  .brand:visited {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 28px;
    letter-spacing: -0.02em;
    color: var(--ink);
    border: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
  }

  .brand:hover {
    color: var(--accent-strong);
    border: 0;
  }

  .brand-tagline {
    font-style: normal;
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  nav.primary {
    display: flex;
    gap: 28px;
  }

  nav.primary a,
  nav.primary a:visited {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border: 0;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    display: inline-flex;
    align-items: center;
  }

  /* Touch-target spec: ≥44 px tap area on coarse pointers, without altering
     the visual rhythm. The padding lands on top so the baseline sits flush
     with the brand wordmark, and the border-bottom rule still tracks the
     11 px label. */
  @media (max-width: 720px), (pointer: coarse) {
    nav.primary a,
    nav.primary a:visited {
      min-height: 44px;
      padding-top: 16px;
      padding-bottom: 4px;
    }

    .brand,
    .brand:visited {
      min-height: 44px;
    }
  }

  nav.primary a:hover {
    color: var(--ink);
    border-bottom-color: transparent;
  }

  nav.primary a.active,
  nav.primary a.active:visited {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
</style>
