---
const path = Astro.url.pathname;
const isHome = path === "/";
const isAbout = path === "/about" || path.startsWith("/about/");
---

<header>
  <a class="brand" href="/" aria-label="Verso, página inicial">
    <svg
      fill="none"
      viewBox="0 0 48 48"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path d="M6 6H42L36 24L42 42H6L12 24L6 6Z" fill="currentColor"></path>
    </svg>
    <span class="wordmark">Verso</span>
  </a>

  <nav>
    <ul>
      <li>
        <a href="/" class:list={{ current: isHome }} aria-current={isHome ? "page" : undefined}>Início</a>
      </li>
      <li>
        <a href="/about" class:list={{ current: isAbout }} aria-current={isAbout ? "page" : undefined}>Sobre</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-lg) var(--space-md);
    max-width: 50rem;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  header a.brand,
  header a.brand:visited {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--content-color-primary);
    text-decoration: none;
    min-height: 44px;
  }

  header a.brand:hover {
    text-decoration: none;
    color: var(--title-color);
  }

  svg {
    width: 22px;
    height: 22px;
    color: inherit;
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: var(--text-subhead);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-lg);
  }

  header nav a,
  header nav a:visited {
    text-decoration: none;
    color: var(--content-color-secondary);
    font-size: var(--text-caption);
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  header nav a.current,
  header nav a.current:visited {
    color: var(--content-color-primary);
  }

  header nav a:hover {
    color: var(--content-color-primary);
    text-decoration: none;
  }
</style>
