---
interface Props {
  to: string;
  title: string;
  description: string;
  date: Date;
  num: string;
  readTime: string;
}

const { to, title, description, date, num, readTime } = Astro.props as Props;
---

<li class="post-row">
  <a href={to} class="post-link">
    <div class="post-num">№ {num}</div>
    <div class="post-body">
      <h2 class="post-title">{title}</h2>
      {description && <p class="post-desc">{description}</p>}
    </div>
    <div class="post-meta">
      <time datetime={date.toISOString()}>
        {
          date.toLocaleDateString("pt-BR", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
      <span class="post-readtime">
        {readTime}
        <span class="post-arrow" aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</li>

<style>
  .post-row {
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .post-link,
  .post-link:visited {
    display: grid;
    grid-template-columns: 64px 1fr 140px;
    gap: 28px;
    align-items: baseline;
    padding: 28px 0;
    color: var(--ink);
    border: 0;
    transition: padding 240ms ease;
  }

  .post-link:hover {
    padding-left: 8px;
    border: 0;
    color: var(--ink);
  }

  .post-link:hover .post-title {
    color: var(--accent-strong);
  }

  .post-link:hover .post-arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  .post-num {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.1em;
    font-variant-caps: all-small-caps;
    color: var(--ink-faint);
  }

  .post-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.018em;
    color: var(--ink);
    margin: 0 0 8px;
    transition: color 200ms ease;
  }

  /* Visited posts dim — quiet "you've read this" mark.
     :visited is restricted to color in modern browsers for privacy. */
  .post-link:visited .post-title {
    color: var(--ink-soft);
  }

  .post-desc {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0;
    max-width: 56ch;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-end;
    text-align: right;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.06em;
    font-variant-caps: all-small-caps;
    color: var(--ink-faint);
  }

  .post-meta time {
    font-family: var(--serif);
    color: var(--ink-faint);
  }

  .post-readtime {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }

  .post-arrow {
    opacity: 0;
    color: var(--accent);
    font-family: var(--serif);
    font-style: italic;
    transition:
      opacity 200ms ease,
      transform 240ms ease;
  }

  @media (max-width: 720px) {
    .post-link {
      grid-template-columns: 40px 1fr;
      gap: 16px;
    }
    .post-meta {
      grid-column: 2;
      align-items: flex-start;
      text-align: left;
      margin-top: 4px;
      flex-direction: row;
      gap: 14px;
    }
    .post-title {
      font-size: 24px;
    }
  }
</style>
