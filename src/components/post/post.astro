---
interface Props {
  to: string;
  title: string;
  description: string;
  date: Date;
}

const { to, title, description, date } = Astro.props as Props;
const hasDescription = Boolean(description);
---

<a href={to} class:list={{ "with-description": hasDescription }}>
  <div class="head">
    <h2>{title}</h2>
    <time datetime={date.toISOString()}>
      {
        date.toLocaleDateString("pt-BR", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      }
    </time>
  </div>
  {description && <p>{description}</p>}
</a>

<style>
  a {
    display: block;
    color: var(--content-color-primary);
    text-decoration: none;
    font-family: var(--font-serif);
  }

  /* Visited posts dim — a quiet "you've read this" mark.
     Browsers restrict :visited to color properties only for privacy. */
  a:visited h2 {
    color: var(--content-color-secondary);
  }

  a:visited p,
  a:visited time {
    color: var(--content-color-tertiary);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  h2 {
    font-size: var(--text-subhead);
    font-weight: 600;
    margin: 0;
    line-height: var(--leading-snug);
  }

  p {
    margin: var(--space-xs) 0 0;
    line-height: var(--leading-snug);
    color: var(--content-color-secondary);
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-style: italic;
    max-width: 50ch;
  }

  time {
    color: var(--content-color-tertiary);
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-style: italic;
    white-space: nowrap;
  }

  a:hover h2 {
    color: var(--title-color);
  }

  a:hover {
    text-decoration: none;
  }
</style>
