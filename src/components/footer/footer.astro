---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide">
    <div class="site-footer-inner">
      <span class="colophon">Verso · MMXXVI</span>
      <span class="colophon">composto em Fraunces &amp; JetBrains Mono</span>
      <span class="colophon">© {currentYear} — escrito em silêncio</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    flex-shrink: 0;
    margin-top: 96px;
    padding: 32px 0 40px;
    border-top: 1px solid var(--rule);
  }

  .site-footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
  }

  .colophon {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
