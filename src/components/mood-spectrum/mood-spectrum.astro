---
import { MOODS, moodLabel, moodGloss, type Mood } from "../../lib/moods/moods";

interface Props {
  /** Highlight one mood as the current position. Omit for a neutral key. */
  active?: Mood;
  /** Shown small above the ramp. */
  caption?: string;
}

const { active, caption } = Astro.props;

const ariaLabel = active
  ? `Escala de humor, de radiante a raiva. Esta noite: ${moodLabel[active]}, ${moodGloss[active]}.`
  : "Escala de humor, de radiante (mais leve) a raiva (mais pesado).";
---

<figure class="mood-spectrum" role="img" aria-label={ariaLabel}>
  {caption && <figcaption class="spectrum-caption label">{caption}</figcaption>}
  <ol class="spectrum-track" aria-hidden="true">
    {
      MOODS.map((mood: Mood) => (
        <li
          class:list={["spectrum-stop", { "is-active": active === mood }]}
          data-mood={mood}
        >
          <span class="spectrum-dot" />
          <span class="spectrum-name">{moodLabel[mood]}</span>
        </li>
      ))
    }
  </ol>
  <div class="spectrum-ends" aria-hidden="true">
    <span>mais leve</span>
    <span>mais pesado</span>
  </div>
</figure>

<style>
  .mood-spectrum {
    margin: 0;
  }

  .spectrum-caption {
    display: block;
    margin-bottom: 16px;
  }

  .spectrum-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    align-items: start;
    position: relative;
  }

  /* The scale line the dots sit on — a hairline that reads as one continuum.
     Insets by half a column so it starts/ends under the outer dots. */
  .spectrum-track::before {
    content: "";
    position: absolute;
    top: 5px;
    left: calc(100% / 16);
    right: calc(100% / 16);
    height: 1px;
    background: var(--rule);
  }

  .spectrum-stop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    position: relative;
    text-align: center;
  }

  .spectrum-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--mood-dot);
    position: relative;
    /* sit cleanly on the hairline, masking it behind the dot */
    box-shadow: 0 0 0 3px var(--ground);
    transition:
      transform var(--dur-base) var(--ease-out-quart),
      opacity var(--dur-base) var(--ease-out-quart);
  }

  .spectrum-name {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.06em;
    font-variant-caps: all-small-caps;
    color: var(--ink-faint);
    line-height: 1.1;
    transition: color var(--dur-fast) var(--ease-out-quart);
  }

  .spectrum-ends {
    display: flex;
    justify-content: space-between;
    margin-top: 14px;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 13px;
    color: var(--marginalia, var(--ink-faint));
    color: var(--ink-faint);
  }

  /* Active position: the marked dot grows and its label lifts to the tint;
     the rest recede so the eye lands on tonight. */
  .mood-spectrum:has(.is-active) .spectrum-dot {
    opacity: 0.55;
  }

  .mood-spectrum:has(.is-active) .spectrum-stop:not(.is-active) .spectrum-name {
    color: var(--ink-ghost);
  }

  .spectrum-stop.is-active .spectrum-dot {
    opacity: 1;
    transform: scale(1.5);
    box-shadow:
      0 0 0 3px var(--ground),
      0 0 0 4px var(--mood-dot);
  }

  .spectrum-stop.is-active .spectrum-name {
    color: var(--mood-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .spectrum-dot {
      transition: none;
    }
  }

  /* Narrow: labels collide at 7-across, so drop them and let the colored ramp
     plus the end captions carry the scale. The active dot still stands out. */
  @media (max-width: 600px) {
    .spectrum-name {
      display: none;
    }

    .spectrum-track {
      gap: 0;
    }

    .spectrum-ends {
      margin-top: 12px;
    }
  }
</style>
