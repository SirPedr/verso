---
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";

import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2";
import frauncesLatinItalic from "@fontsource-variable/fraunces/files/fraunces-latin-full-italic.woff2";

import "../styles/base.css";

interface Props {
  title: string;
  /** When false, hides the masthead's "voltar" link (the index page itself). */
  showIndexLink?: boolean;
}

const { title, showIndexLink = true } = Astro.props;
---

<html lang="pt-BR" data-theme="soft" data-body="serif">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Unlisted: keep the diário out of search and off any crawler. -->
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link
      rel="preload"
      href={frauncesLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={frauncesLatinItalic}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="diary-masthead">
        <div class="container">
          <div class="diary-masthead-inner">
            <a class="diary-mark" href="/journal">
              <span class="diary-mark-name">o diário</span>
              <span class="diary-mark-tag">privado · não listado</span>
            </a>
            {
              showIndexLink && (
                <a class="diary-index-link" href="/journal">
                  todas as noites
                </a>
              )
            }
          </div>
        </div>
      </header>

      <main class="page-enter">
        <slot />
      </main>

      <footer class="diary-footer">
        <div class="container">
          <span class="colophon">escrito só para mim</span>
          <span class="colophon">sem data de publicação</span>
        </div>
      </footer>
    </div>
  </body>

  <style is:global>
    main {
      flex: 1 0 auto;
    }

    /* ── Mood spectrum ────────────────────────────────────────────────────────
       One broad, muted OKLCH ramp (mais leve → mais pesado): green/teal at the
       good end, chroma washing to near-0 at neutro (the plain days), then
       cool→warm down to brick red at raiva. Lightness descends as the mood gets
       heavier. Every hue kept off rust (H≈62). Verified on the Soft Black ground:
       --mood-dot ≥ 3:1 (graphical), --mood-ink ≥ 4.5:1 (text). Order matches
       MOODS in lib/moods. */
    [data-mood="radiante"] {
      --mood-dot: #8cb088; /* fresh green — a day that went right */
      --mood-ink: #afceac;
    }
    [data-mood="leve"] {
      --mood-dot: #7c9f8a; /* sage — light, unburdened */
      --mood-ink: #a2c0ad;
    }
    [data-mood="tranquilo"] {
      --mood-dot: #669696; /* dusty teal — calm, at ease */
      --mood-ink: #93baba;
    }
    [data-mood="neutro"] {
      --mood-dot: #7d8488; /* ash — the plain, just-fine hinge */
      --mood-ink: #a2a9ad;
    }
    [data-mood="melancolia"] {
      --mood-dot: #8282a5; /* periwinkle — a tristeza sem pressa */
      --mood-ink: #a7a7c7;
    }
    [data-mood="solidao"] {
      --mood-dot: #88779d; /* violet — cold aloneness */
      --mood-ink: #afa0c3;
    }
    [data-mood="angustia"] {
      --mood-dot: #986986; /* mauve-magenta — the aperto, dread */
      --mood-ink: #bd93ac;
    }
    [data-mood="raiva"] {
      --mood-dot: #a35955; /* banked brick — anger, kept off rust */
      --mood-ink: #c6857e;
    }
  </style>

  <style>
    .diary-masthead {
      padding: 36px 0 0;
    }

    .diary-masthead-inner {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-bottom: 1px solid var(--rule);
      padding-bottom: 28px;
      gap: 24px;
      flex-wrap: wrap;
    }

    .diary-mark,
    .diary-mark:visited {
      font-family: var(--serif);
      font-style: italic;
      font-weight: 300;
      font-size: 28px;
      letter-spacing: -0.02em;
      color: var(--ink);
      border: 0;
      display: inline-flex;
      align-items: baseline;
      gap: 12px;
    }

    .diary-mark:hover {
      color: var(--accent-strong);
      border: 0;
    }

    .diary-mark-tag {
      font-style: normal;
      font-family: var(--serif);
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.12em;
      font-variant-caps: all-small-caps;
      color: var(--ink-faint);
    }

    .diary-index-link,
    .diary-index-link:visited {
      font-family: var(--serif);
      font-weight: 500;
      font-size: 15px;
      letter-spacing: 0.1em;
      font-variant-caps: all-small-caps;
      color: var(--ink-soft);
      border: 0;
      padding-bottom: 4px;
      border-bottom: 1px solid transparent;
      display: inline-flex;
      align-items: center;
    }

    .diary-index-link:hover {
      color: var(--ink);
      border: 0;
    }

    @media (max-width: 720px), (pointer: coarse) {
      .diary-index-link,
      .diary-index-link:visited {
        min-height: 44px;
        padding-top: 16px;
        padding-bottom: 4px;
      }

      .diary-mark,
      .diary-mark:visited {
        min-height: 44px;
      }
    }

    .diary-footer {
      flex-shrink: 0;
      margin-top: 96px;
      padding: 32px 0 40px;
      border-top: 1px solid var(--rule);
    }

    .diary-footer .container {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 24px;
      flex-wrap: wrap;
    }

    .colophon {
      font-family: var(--serif);
      font-weight: 500;
      font-size: 13px;
      letter-spacing: 0.1em;
      font-variant-caps: all-small-caps;
      color: var(--ink-faint);
    }
  </style>
</html>
