---
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";

import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2";
import frauncesLatinItalic from "@fontsource-variable/fraunces/files/fraunces-latin-full-italic.woff2";

import "../styles/base.css";

import Footer from "../components/footer/footer.astro";
import Header from "../components/header/header.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="pt-BR" data-theme="soft" data-body="serif">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link
      rel="preload"
      href={frauncesLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={frauncesLatinItalic}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <Header />
      <main class="page-enter">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  main {
    flex: 1 0 auto;
  }
</style>
