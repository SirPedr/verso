---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/base-layout.astro";
import { render } from "astro:content";
import { sortByDate } from "../../lib/sort-by-date/sort-by-date";
import { readTime } from "../../lib/read-time/read-time";
import { postKind, isLyric } from "../../lib/post-kind/post-kind";

export const getStaticPaths = async () => {
  const posts = await getCollection("posts");
  const sorted = posts.sort((a, b) =>
    sortByDate(a.data.launch_date, b.data.launch_date)
  );
  return sorted.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      newer: sorted[index - 1] ?? null,
      older: sorted[index + 1] ?? null,
    },
  }));
};

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

const lyric = isLyric(post.data.description);
const kind = postKind(post.data.description);
const minutes = readTime(post.body);
const dateLabel = post.data.launch_date.toLocaleDateString("pt-BR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${post.data.title} · Verso`}>
  <article class:list={["post", lyric ? "lyric" : "essay"]}>
    <div class="container">
      <div class="article">
        <header class="article-header">
          <div class="article-eyebrow">
            <span class="label">{kind}</span>
            <span class="meta">{dateLabel}</span>
            <span class="meta">{minutes}</span>
          </div>

          <h1 class="article-title">{post.data.title}</h1>

          {
            post.data.description && (
              <p class="article-desc">{post.data.description}</p>
            )
          }

          <hr class="article-rule" />
        </header>

        <div class="prose">
          <Content />
        </div>

        <div class="article-end">
          <span class="end-mark">— fim —</span>
          <a href="/" class="back-link">← voltar ao índice</a>
        </div>

        {
          (newer || older) && (
            <nav class="post-nav" aria-label="Navegação entre textos">
              <div class="post-nav-cell">
                {newer && (
                  <a href={`/posts/${newer.id}`} class="post-nav-link">
                    <div class="label">← Mais recente</div>
                    <div class="post-nav-title">{newer.data.title}</div>
                  </a>
                )}
              </div>
              <div class="post-nav-cell post-nav-right">
                {older && (
                  <a href={`/posts/${older.id}`} class="post-nav-link">
                    <div class="label">Mais antigo →</div>
                    <div class="post-nav-title">{older.data.title}</div>
                  </a>
                )}
              </div>
            </nav>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding: 88px 0 24px;
  }

  .article-header {
    margin-bottom: 56px;
  }

  .article-eyebrow {
    display: flex;
    gap: 18px;
    align-items: baseline;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .article-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin: 0 0 24px;
    color: var(--ink);
    font-variation-settings:
      "opsz" 144,
      "SOFT" 50;
  }

  .article-desc {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 22px;
    line-height: 1.45;
    color: var(--ink-soft);
    margin: 0;
    max-width: 56ch;
  }

  .article-rule {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 56px 0 0;
  }

  .article-end {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    gap: 16px;
    flex-wrap: wrap;
  }

  .end-mark {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-faint);
  }

  .back-link,
  .back-link:visited {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.12em;
    font-variant-caps: all-small-caps;
    color: var(--ink-faint);
    border: 0;
  }

  .back-link:hover {
    color: var(--ink);
    border: 0;
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }

  .post-nav-cell {
    flex: 1;
    min-width: 0;
  }

  .post-nav-right {
    text-align: right;
  }

  .post-nav-link,
  .post-nav-link:visited {
    display: block;
    border: 0;
    color: var(--ink-soft);
  }

  .post-nav-link:hover {
    border: 0;
    color: var(--accent-strong);
  }

  .post-nav-link .label {
    margin-bottom: 8px;
  }

  .post-nav-title {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 20px;
    line-height: 1.3;
    color: var(--ink-soft);
    transition: color 180ms ease;
  }

  .post-nav-link:hover .post-nav-title {
    color: var(--accent-strong);
  }
</style>
