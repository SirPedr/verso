---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/base-layout.astro";
import { render } from "astro:content";

export const getStaticPaths = async () => {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);

const isLyric = (post.data.description ?? "").startsWith("Música");
---

<BaseLayout title={`${post.data.title} · Verso`} wide>
  <article class:list={["post", { lyric: isLyric, prose: !isLyric }]}>
    <header>
      <h1>{post.data.title}</h1>
      {
        post.data.description && (
          <p class="subtitle">{post.data.description}</p>
        )
      }
      <time datetime={post.data.launch_date.toISOString()}>
        {
          post.data.launch_date.toLocaleDateString("pt-BR", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
    </header>

    <section>
      <Content />
    </section>

    <footer>
      <svg
        viewBox="0 0 48 48"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path d="M6 6H42L36 24L42 42H6L12 24L6 6Z" fill="currentColor"></path>
      </svg>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    font-family: var(--font-serif);
  }

  header {
    margin-bottom: var(--space-2xl);
    max-width: var(--measure-prose);
  }

  h1 {
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    font-weight: 600;
    color: var(--title-color);
    margin: 0 0 var(--space-sm);
    letter-spacing: -0.01em;
  }

  .subtitle {
    font-style: italic;
    color: var(--content-color-tertiary);
    font-size: var(--text-subhead);
    margin: 0 0 var(--space-md);
    line-height: var(--leading-snug);
  }

  time {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-style: italic;
    color: var(--content-color-tertiary);
  }

  section {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    hanging-punctuation: first allow-end last;
    max-width: var(--measure-prose);
  }

  section :global(p) {
    margin: 0 0 1.25em;
    text-align: left;
    text-wrap: pretty;
    hyphens: auto;
  }

  /* Drop cap on first paragraph of prose posts only */
  .prose section :global(p:first-of-type::first-letter) {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 4em;
    float: left;
    line-height: 0.85;
    padding: 0.1em 0.1em 0 0;
    margin-right: 0.05em;
    color: var(--title-color);
  }

  /* Lyric posts: tighter, no drop cap, narrower feel */
  .lyric section {
    line-height: var(--leading-snug);
  }

  .lyric section :global(p) {
    margin-bottom: var(--space-lg);
  }

  article > footer {
    margin-top: var(--space-3xl);
    text-align: center;
    color: var(--content-color-tertiary);
  }

  article > footer svg {
    width: 1rem;
    height: 1rem;
    opacity: 0.6;
  }
</style>
