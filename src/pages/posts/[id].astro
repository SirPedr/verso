---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/base-layout.astro";
import { render } from "astro:content";

export const getStaticPaths = async () => {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);

const isLyric = (post.data.description ?? "").startsWith("Música");
---

<BaseLayout title={post.data.title}>
  <article class:list={["post", { lyric: isLyric, prose: !isLyric }]}>
    <header>
      <h1>{post.data.title}</h1>
      <p class="subtitle">{post.data.description}</p>
      <time datetime={post.data.launch_date.toISOString()}>
        {
          post.data.launch_date.toLocaleDateString("pt-BR", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
    </header>

    <section>
      <Content />
    </section>
  </article>
</BaseLayout>

<style>
  .post {
    font-family: var(--font-serif);
  }

  header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    font-weight: 600;
    color: var(--title-color);
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }

  .subtitle {
    font-style: italic;
    color: var(--content-color-tertiary);
    font-size: var(--text-subhead);
    margin: 0 0 0.75rem;
    line-height: var(--leading-snug);
  }

  time {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-style: italic;
    color: var(--content-color-tertiary);
  }

  section {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    hanging-punctuation: first allow-end last;
  }

  section :global(p) {
    margin: 0 0 1.25rem;
    text-align: left;
    text-wrap: pretty;
    hyphens: auto;
  }

  /* Drop cap on first paragraph of prose posts only */
  .prose section :global(p:first-of-type::first-letter) {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 4em;
    float: left;
    line-height: 0.85;
    padding: 0.1em 0.1em 0 0;
    margin-right: 0.05em;
    color: var(--title-color);
  }

  /* Lyric posts: tighter, no drop cap, narrower feel */
  .lyric section {
    line-height: var(--leading-snug);
  }

  .lyric section :global(p) {
    margin-bottom: 1.5rem;
  }
</style>
