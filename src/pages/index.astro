---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/base-layout.astro";
import Post from "../components/post/post.astro";
import { sortByDate } from "../lib/sort-by-date/sort-by-date";
import { filterByQueryTrigger } from "../lib/filter-by-query-trigger/filter-by-query-trigger";

export const prerender = false;

const searchParams = Astro.url.searchParams;
const posts = await getCollection("posts");

const sortedPosts = posts
  .filter((post) => filterByQueryTrigger(post, searchParams))
  .sort((firstPost, secondPost) =>
    sortByDate(firstPost.data.launch_date, secondPost.data.launch_date)
  );
---

<BaseLayout title="Verso">
  <section>
    {
      sortedPosts.map((post) => (
        <Post
          to={`/posts/${post.id}`}
          title={post.data.title}
          description={post.data.description}
          date={post.data.launch_date}
        />
      ))
    }
  </section>
</BaseLayout>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* Posts with descriptions get a touch more breathing room beneath */
  section :global(a.with-description) {
    padding-bottom: var(--space-xs);
  }
</style>
