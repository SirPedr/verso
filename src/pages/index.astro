---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/base-layout.astro";
import Post from "../components/post/post.astro";
import { sortByDate } from "../lib/sort-by-date/sort-by-date";

const posts = await getCollection("posts");

const sortedPosts = posts.sort((firstPost, secondPost) =>
  sortByDate(firstPost.data.launch_date, secondPost.data.launch_date)
);
---

<BaseLayout title="Verso">
  <p class="epigraph">Solidão, angústia, e a busca por significado.</p>
  <section>
    {
      sortedPosts.map((post) => (
        <Post
          to={`/posts/${post.id}`}
          title={post.data.title}
          description={post.data.description}
          date={post.data.launch_date}
        />
      ))
    }
  </section>
</BaseLayout>

<style>
  .epigraph {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--content-color-tertiary);
    font-size: var(--text-body);
    margin: 0 0 var(--space-2xl);
    max-width: var(--measure-prose);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* Posts with descriptions get a touch more breathing room beneath */
  section :global(a.with-description) {
    padding-bottom: var(--space-xs);
  }
</style>
