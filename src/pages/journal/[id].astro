---
import { getCollection, render } from "astro:content";
import JournalLayout from "../../layouts/journal-layout.astro";
import MoodSpectrum from "../../components/mood-spectrum/mood-spectrum.astro";
import { moodLabel, moodGloss, type Mood } from "../../lib/moods/moods";
import { fmtDate, fmtTime, hasTime } from "../../lib/journal-date/journal-date";

export const getStaticPaths = async () => {
  const entries = await getCollection("journal");
  const sorted = entries.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return sorted.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      newer: sorted[index - 1] ?? null,
      older: sorted[index + 1] ?? null,
    },
  }));
};

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);

const mood = entry.data.mood as Mood;
const dateLabel = fmtDate(entry.data.date);
const timeLabel = fmtTime(entry.data.date);
// Only show a time when the entry actually carried one (not a bare date).
const entryHasTime = hasTime(entry.data.date);

const title = pageTitle();
function pageTitle() {
  const base = entry.data.title ?? moodLabel[mood];
  return `${base} · o diário`;
}
---

<JournalLayout title={title}>
  <article class="diary-entry" data-mood={mood}>
    <div class="container">
      <header class="entry-header">
        <div class="entry-eyebrow">
          <span class="mood-tag">
            <span class="mood-dot" aria-hidden="true"></span>
            <span class="mood-label">{moodLabel[mood]}</span>
          </span>
          <span class="meta">{dateLabel}</span>
          {entryHasTime && <span class="meta">{timeLabel}</span>}
        </div>

        {entry.data.title && <h1 class="entry-title">{entry.data.title}</h1>}

        <p class="mood-gloss">{moodGloss[mood]}</p>

        <div class="entry-spectrum">
          <MoodSpectrum active={mood} />
        </div>

        <hr class="entry-rule" />
      </header>

      <div class="prose">
        <Content />
      </div>

      <div class="entry-close">
        <span class="close-mark" aria-hidden="true"></span>
        <a href="/journal" class="back-link">← voltar ao diário</a>
      </div>

      {
        (newer || older) && (
          <nav class="entry-nav" aria-label="Outras noites">
            <div class="entry-nav-cell">
              {newer && (
                <a
                  href={`/journal/${newer.id}`}
                  class="entry-nav-link"
                  data-mood={newer.data.mood}
                >
                  <span class="label">← noite seguinte</span>
                  <span class="entry-nav-title">
                    {newer.data.title ?? moodLabel[newer.data.mood as Mood]}
                  </span>
                </a>
              )}
            </div>
            <div class="entry-nav-cell entry-nav-right">
              {older && (
                <a
                  href={`/journal/${older.id}`}
                  class="entry-nav-link"
                  data-mood={older.data.mood}
                >
                  <span class="label">noite anterior →</span>
                  <span class="entry-nav-title">
                    {older.data.title ?? moodLabel[older.data.mood as Mood]}
                  </span>
                </a>
              )}
            </div>
          </nav>
        )
      }
    </div>
  </article>
</JournalLayout>

<style>
  .diary-entry {
    padding: 72px 0 24px;
  }

  .entry-header {
    margin-bottom: 48px;
  }

  .entry-eyebrow {
    display: flex;
    gap: 18px;
    align-items: baseline;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .mood-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 9px;
  }

  .mood-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--mood-dot);
    flex: none;
    align-self: center;
  }

  .mood-label {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.1em;
    font-variant-caps: all-small-caps;
    color: var(--mood-ink);
  }

  .entry-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.06;
    letter-spacing: -0.025em;
    margin: 0 0 18px;
    color: var(--ink);
    text-wrap: balance;
    font-variation-settings:
      "opsz" 144,
      "SOFT" 50;
  }

  .mood-gloss {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 20px;
    line-height: 1.45;
    color: var(--ink-soft);
    margin: 0;
    max-width: 46ch;
  }

  .entry-spectrum {
    margin-top: 36px;
    max-width: 520px;
  }

  .entry-rule {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 44px 0 0;
  }

  /* The mood carries into the prose quietly: blockquote rule and any strong
     emphasis pick up the tint instead of rust, keeping rust reserved. */
  .diary-entry :global(.prose blockquote) {
    border-left-color: var(--mood-dot);
  }

  .entry-close {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    gap: 16px;
    flex-wrap: wrap;
  }

  /* A small mood-tinted square as the end mark — a page closed for the night. */
  .close-mark {
    width: 8px;
    height: 8px;
    background: var(--mood-dot);
    display: inline-block;
  }

  .back-link,
  .back-link:visited {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.12em;
    font-variant-caps: all-small-caps;
    color: var(--ink-faint);
    border: 0;
  }

  .back-link:hover {
    color: var(--ink);
    border: 0;
  }

  .entry-nav {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }

  .entry-nav-cell {
    flex: 1;
    min-width: 0;
  }

  .entry-nav-right {
    text-align: right;
  }

  .entry-nav-link,
  .entry-nav-link:visited {
    display: block;
    border: 0;
    color: var(--ink-soft);
  }

  .entry-nav-link:hover {
    border: 0;
  }

  .entry-nav-link .label {
    display: flex;
    margin-bottom: 8px;
    color: var(--ink-faint);
  }

  .entry-nav-right .label {
    justify-content: flex-end;
  }

  .entry-nav-title {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 20px;
    line-height: 1.3;
    color: var(--ink-soft);
    transition: color var(--dur-fast) var(--ease-out-quart);
  }

  .entry-nav-link:hover .entry-nav-title {
    color: var(--mood-ink);
  }
</style>
