---
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout title="Perdido nos versos · Verso">
  <div class="mark" aria-hidden="true">
    <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
      <path d="M6 6H42L36 24L42 42H6L12 24L6 6Z" fill="currentColor"></path>
    </svg>
  </div>
  <h1>Perdido nos versos</h1>
  <p>
    Parece que a página que você procura se perdeu. Talvez nunca tenha sido
    escrita ou tenha sido movida para um outro caminho.
  </p>
  <p class="back">
    <a href="/">Voltar ao início</a>
  </p>
</BaseLayout>

<style>
  .mark {
    display: flex;
    justify-content: center;
    color: var(--content-color-tertiary);
    margin-bottom: var(--space-xl);
  }

  .mark svg {
    width: clamp(6rem, 14vw, 9rem);
    height: clamp(6rem, 14vw, 9rem);
  }

  h1 {
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-display);
    font-weight: 600;
    color: var(--title-color);
    margin: 0 0 var(--space-md);
    letter-spacing: -0.01em;
  }

  p {
    max-width: 30rem;
    margin: 0 auto;
    text-align: center;
    line-height: var(--leading-body);
    color: var(--content-color-secondary);
  }

  p.back {
    margin-top: var(--space-xl);
    font-family: var(--font-serif);
    font-style: italic;
  }
</style>
