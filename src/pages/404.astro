---
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout title="Perdido nos versos · Verso">
  <div class="container">
    <div class="notfound">
      <div class="eyebrow">Erro · página não encontrada</div>

      <h1 class="notfound-num">
        4<span class="zero">0</span>4
      </h1>

      <p class="notfound-msg">
        <em>Esta página</em> — se um dia existiu — se perdeu nos versos:
        guardada numa gaveta, aquecida por uma ausência diferente. Tente o
        <a href="/">índice</a>, ou fique aqui mais um instante. O cômodo
        não é hostil.
      </p>

      <div class="notfound-links">
        <a href="/" class="label-link">← voltar ao início</a>
        <span class="meta" aria-hidden="true">·</span>
        <a href="/about" class="label-link">ler o colofão</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 80px 0;
  }

  .eyebrow {
    margin-bottom: 24px;
  }

  .notfound-num {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(140px, 22vw, 260px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin: 0;
    font-variation-settings: "opsz" 144;
  }

  .notfound-num .zero {
    color: var(--accent);
  }

  .notfound-msg {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 24px;
    line-height: 1.4;
    color: var(--ink-soft);
    max-width: 480px;
    margin: 32px 0 40px;
  }

  .notfound-msg em {
    color: var(--ink);
    font-style: italic;
  }

  .notfound-msg a,
  .notfound-msg a:visited {
    color: var(--ink);
    border-bottom-color: var(--accent-deep);
  }

  .notfound-msg a:hover {
    color: var(--accent-strong);
  }

  .notfound-links {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .label-link,
  .label-link:visited {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.12em;
    font-variant-caps: all-small-caps;
    color: var(--ink-faint);
    border: 0;
  }

  .label-link:hover {
    color: var(--ink);
    border: 0;
  }
</style>
