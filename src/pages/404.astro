---
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout title="404 - Not Found">
  <h1>404</h1>
  <h2>Perdido nos versos</h2>
  <p>
    Parece que a página que você procura se perdeu. Talvez nunca tenha sido
    escrita ou tenha sido movida para um outro caminho.
  </p>
</BaseLayout>

<style>
  h1 {
    text-align: center;
    font-size: clamp(5rem, 18vw, 9rem);
    font-weight: 600;
    color: var(--title-color);
    margin-bottom: 0;
    letter-spacing: -0.02em;
  }

  h2 {
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-heading);
    font-weight: 400;
    margin-top: 0;
    margin-bottom: 1rem;
    color: var(--content-color-secondary);
  }

  p {
    max-width: 30rem;
    margin: 0 auto;
    text-align: center;
    line-height: var(--leading-body);
    color: var(--content-color-secondary);
  }

  @media screen and (min-width: 768px) {
    h2 {
      margin-top: 1.5rem;
    }
  }
</style>
